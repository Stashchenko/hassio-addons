#!/usr/bin/with-contenv bashio
# ==============================================================================
# Start the example service
# s6-overlay docs: https://github.com/just-containers/s6-overlay
# ==============================================================================

until [ -e /run/avahi-daemon/pid ]; do
    sleep 1s
done

bashio::log.info "Waiting for PulseAudio to become available..."
for _ in $(seq 1 60); do
    [ -S /run/audio/pulse.sock ] && break
    sleep 1s
done
if [ ! -S /run/audio/pulse.sock ]; then
    bashio::log.warning "PulseAudio socket not found after 60s; starting client anyway."
fi

SPIN_THRESHOLD=50
SPIN_WINDOW=10

get_sink() {
    pactl list sinks short 2>/dev/null \
        | awk '$2 ~ /^alsa_output/ && $2 !~ /\.monitor$/ { print $2; exit }'
}

reset_sink() {
    local sink
    sink="$(get_sink)"
    [ -z "$sink" ] && sink="@DEFAULT_SINK@"
    bashio::log.warning  "Resetting PulseAudio sink '${sink}' to recover the stuck DAC clock."
    pactl suspend-sink "$sink" 1 2>/dev/null
    sleep 1s
    pactl suspend-sink "$sink" 0 2>/dev/null
}

# Simple restart loop for an extra client pinned to a specific PulseAudio sink.
run_extra_client() {
    local host_id="$1"
    local sink="$2"
    while true; do
       bashio::log.info "Starting snapcast client '${host_id}' on sink '${sink}'..."
       PULSE_SINK="$sink" /usr/bin/snapclient --host 127.0.0.1 --hostID "$host_id" --player pulse
       bashio::log.info "snapcast client '${host_id}' exited; restarting in 3s..."
       sleep 3s
    done
}

# Launch extra clients in the background, each on its own sink.
if bashio::config.has_value 'extra_clients'; then
    for idx in $(bashio::config 'extra_clients|keys[]'); do
        name="$(bashio::config "extra_clients[${idx}].name")"
        sink="$(bashio::config "extra_clients[${idx}].sink")"

        slug="$(printf '%s' "$name" | tr '[:upper:] ' '[:lower:]-' | tr -cd 'a-z0-9-')"
        [ -z "$slug" ] && slug="extra-${idx}"

        run_extra_client "home-assistant-${slug}" "$sink" &
    done
fi

fifo="/tmp/snapclient.fifo"
rm -f "$fifo"
mkfifo "$fifo"

while true; do
    bashio::log.info "Starting snapcast client..."

    /usr/bin/snapclient --host 127.0.0.1 --hostID home-assistant --player pulse >"$fifo" 2>&1 &
    snap_pid=$!

    count=0
    window_start=$(date +%s)

    while IFS= read -r line; do
        printf '%s\n' "$line"

        case "$line" in
            *outputBufferDacTime*)
                now=$(date +%s)
                if [ $((now - window_start)) -ge "$SPIN_WINDOW" ]; then
                    count=0
                    window_start=$now
                fi
                count=$((count + 1))
                if [ "$count" -ge "$SPIN_THRESHOLD" ]; then
                    bashio::log.warning "snapcast client wedged on the audio clock (${count} buffer errors in <${SPIN_WINDOW}s)."
                    reset_sink
                    kill "$snap_pid" 2>/dev/null
                    break
                fi
                ;;
        esac
    done <"$fifo"

    kill "$snap_pid" 2>/dev/null
    wait "$snap_pid" 2>/dev/null
    bashio::log.info "snapcast client exited; restarting in 3s..."
    sleep 3s
done
