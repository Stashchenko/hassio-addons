#!/usr/bin/with-contenv bashio
# ==============================================================================
# Start the example service
# s6-overlay docs: https://github.com/just-containers/s6-overlay
# ==============================================================================

until [ -e /run/avahi-daemon/pid ]; do
    sleep 1s
done

bashio::log.info "Waiting for PulseAudio to become available..."
for _ in $(seq 1 60); do
    [ -S /run/audio/pulse.sock ] && break
    sleep 1s
done
if [ ! -S /run/audio/pulse.sock ]; then
    bashio::log.warning "PulseAudio socket not found after 60s; starting client anyway."
fi

CPU_THRESHOLD=95
CPU_STRIKES=6
CPU_INTERVAL=5
CLK_TCK="$(getconf CLK_TCK 2>/dev/null || echo 100)"

get_running_sink() {
 pactl list sinks short 2>/dev/null | awk '$2 ~ /^alsa_output/ && $2 !~ /\.monitor$/ && toupper($NF) == "RUNNING" { print $2; exit }'
}

# Sum of utime+stime (clock ticks) for a pid; robust to spaces/parens in comm.
proc_cpu_ticks() {
  local stat rest
  stat="$(cat "/proc/$1/stat" 2>/dev/null)" || return 1
  rest="${stat#*) }"
  set -- $rest
  printf '%s' "$(( ${12} + ${13} ))"
}

reset_sink() {
    local sink="$1" err
    [ -z "$sink" ] && sink="@DEFAULT_SINK@"
    bashio::log.warning "Resetting PulseAudio sink '${sink}' to recover the stuck DAC clock."
    if ! err="$(pactl suspend-sink "$sink" 1 2>&1)"; then
      bashio::log.warning "pactl suspend-sink '${sink}' 1 failed: ${err}"
    fi
    sleep 1s
    if ! err="$(pactl suspend-sink "$sink" 0 2>&1)"; then
      bashio::log.warning "pactl suspend-sink '${sink}' 0 failed: ${err}"
    fi
}

# Simple restart loop for an extra client pinned to a specific PulseAudio sink.
run_extra_client() {
    local host_id="$1"
    local sink="$2"
    while true; do
       bashio::log.info "Starting snapcast client '${host_id}' on sink '${sink}'..."
       PULSE_SINK="$sink" /usr/bin/snapclient --host 127.0.0.1 --hostID "$host_id" --player pulse
       bashio::log.info "snapcast client '${host_id}' exited; restarting in 3s..."
       sleep 3s
    done
}

# Launch extra clients in the background, each on its own sink.
if bashio::config.has_value 'extra_clients'; then
    for idx in $(bashio::config 'extra_clients|keys[]'); do
        name="$(bashio::config "extra_clients[${idx}].name")"
        sink="$(bashio::config "extra_clients[${idx}].sink")"

        slug="$(printf '%s' "$name" | tr '[:upper:] ' '[:lower:]-' | tr -cd 'a-z0-9-')"
        [ -z "$slug" ] && slug="extra-${idx}"

        run_extra_client "home-assistant-${slug}" "$sink" &
    done
fi

while true; do
    bashio::log.info "Starting snapcast client..."

    /usr/bin/snapclient --host 127.0.0.1 --hostID home-assistant --player pulse &
    snap_pid=$!

    strikes=0
    prev_ticks="$(proc_cpu_ticks "$snap_pid")" || prev_ticks=0

    while kill -0 "$snap_pid" 2>/dev/null; do
        sleep "$CPU_INTERVAL"

        cur_ticks="$(proc_cpu_ticks "$snap_pid")" || break
        cpu=$(( (cur_ticks - prev_ticks) * 100 / (CLK_TCK * CPU_INTERVAL) ))
        prev_ticks="$cur_ticks"

        if [ "$cpu" -ge "$CPU_THRESHOLD" ]; then
            strikes=$((strikes + 1))
            bashio::log.warning "snapcast client CPU at ${cpu}% of a core (strike ${strikes}/${CPU_STRIKES})."
            if [ "$strikes" -ge "$CPU_STRIKES" ]; then
                running_sink="$(get_running_sink)"
                if [ -n "$running_sink" ]; then
                    bashio::log.warning "snapcast client pegged at ${cpu}% with sink '${running_sink}' RUNNING; resetting it (stuck DAC clock)."
                    reset_sink "$running_sink"
                else
                    bashio::log.warning "snapcast client pegged at ${cpu}% but no RUNNING hardware sink found; restarting client without a sink reset."
                fi
                break
            fi
        else
            strikes=0
        fi
    done

    kill "$snap_pid" 2>/dev/null
    wait "$snap_pid" 2>/dev/null
    bashio::log.info "snapcast client exited; restarting in 3s..."
    sleep 3s
done
